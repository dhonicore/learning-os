# Learning OS — Environment Variables
# Copy to .env and fill in your values. Never commit real secrets.

# Supabase PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Groq API key for LLM tutor
# Get from https://console.groq.com/keys
GROQ_API_KEY=

# Frontend → Backend API origin (production)
# Set to your Render service URL, e.g., https://learning-os-c4h7.onrender.com
NEXT_PUBLIC_API_ORIGIN=